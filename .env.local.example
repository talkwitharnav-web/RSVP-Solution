DATABASE_URL=postgres://postgres:postgres@localhost:5432/rsvp_dev
# Required for every run. The startup scripts generate a private value in
# .env.local when this is blank.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Admin login is disabled until both values are configured in .env.local.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Required for production behind HTTPS. Leave false for local HTTP development.
FORCE_SECURE_COOKIES=false

# Development defaults to 0.0.0.0 for phone/LAN testing. Production defaults
# to 127.0.0.1 so only a same-host HTTPS reverse proxy can reach Node.
# Set HOST=0.0.0.0 in a production container only when its network/firewall
# prevents direct public access to port 3001.
# HOST=

# Production trusts forwarded client IPs only from these direct proxy socket
# addresses. The loopback defaults cover a same-host TLS reverse proxy. For a
# container/network proxy, set an explicit comma-separated IP list.
# TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1
